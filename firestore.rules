rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper checks
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || request.auth.token.email.matches('.*admin@.*'));
    }

    // User accounts
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Public curriculum resources (Read for all, Write only for Admins)
    match /pathways/{pathwayId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /flashcards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notes/{noteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Student progress logs & bookmarks (Only readable/writeable by the student)
    match /progress/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    match /achievements/{achId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
